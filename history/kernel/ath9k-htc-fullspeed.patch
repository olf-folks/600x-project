+/* Verify the expected endpoints are present */
+alt = interface->cur_altsetting;
+
+if (udev->speed == USB_SPEED_FULL) {
+        int i;
+        struct usb_endpoint_descriptor *ep;
+
+        bulk_in = bulk_out = int_in = int_out = NULL;
+
+        for (i = 0; i < alt->desc.bNumEndpoints; i++) {
+                ep = &alt->endpoint[i].desc;
+
+                if (usb_endpoint_num(ep) == USB_WLAN_RX_PIPE &&
+                    usb_endpoint_is_bulk_in(ep))
+                        bulk_in = ep;
+                else if (usb_endpoint_num(ep) == USB_WLAN_TX_PIPE &&
+                         usb_endpoint_is_bulk_out(ep))
+                        bulk_out = ep;
+                else if (usb_endpoint_num(ep) == USB_REG_IN_PIPE &&
+                         usb_endpoint_is_int_in(ep))
+                        int_in = ep;
+                else if (usb_endpoint_num(ep) == USB_REG_OUT_PIPE &&
+                         usb_endpoint_is_bulk_out(ep))
+                        int_out = ep;
+        }
+
+        if (!bulk_in || !bulk_out || !int_in || !int_out) {
+                dev_err(&udev->dev,
+                        "ath9k_htc: Full-speed endpoint layout not supported\n");
+                return -ENODEV;
+        }
+} else {
+        if (usb_find_common_endpoints(alt, &bulk_in, &bulk_out,
+                                      &int_in, &int_out) < 0 ||
+            usb_endpoint_num(bulk_in) != USB_WLAN_RX_PIPE ||
+            usb_endpoint_num(bulk_out) != USB_WLAN_TX_PIPE ||
+            usb_endpoint_num(int_in) != USB_REG_IN_PIPE ||
+            usb_endpoint_num(int_out) != USB_REG_OUT_PIPE) {
+                dev_err(&udev->dev,
+                        "ath9k_htc: Device endpoint numbers are not the expected ones\n");
+                return -ENODEV;
+        }
+}
 
